# FinGuardian AI Environment Configuration Example

PROJECT_NAME="FinGuardian AI"
DEBUG=True
DATABASE_URL="sqlite:///./finguardian.db"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_chat_id"

# Gmail SMTP Official Dispatcher
GMAIL_SENDER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465

# Groq Dual API Keys
GROQ_API_KEY_DECISION="gsk_your_decision_key_here"
GROQ_API_KEY_CHAT="gsk_your_chat_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# Gemini Fallback (Optional)
GEMINI_API_KEY="your_gemini_api_key_here"

# Snowflake Cloud Data Warehouse
SNOWFLAKE_ACCOUNT="your_account_identifier"
SNOWFLAKE_USER="your_snowflake_username"
SNOWFLAKE_PASSWORD="your_snowflake_password"
SNOWFLAKE_ROLE="ACCOUNTADMIN"
SNOWFLAKE_WAREHOUSE="FINGUARDIAN_WH"
SNOWFLAKE_DATABASE="FINGUARDIAN_DW"
SNOWFLAKE_SCHEMA="ANALYTICS"
